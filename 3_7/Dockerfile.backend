FROM golang:1.16-alpine

WORKDIR /app

COPY code/example-backend .

ENV PORT=8080
ENV REQUEST_ORIGIN=http://localhost:5001

RUN go build -o server \
    && rm -rf /root/.cache/go-build /go/pkg/mod \
    && find . -mindepth 1 -maxdepth 1 ! -name server -exec rm -rf {} + \
    && addgroup -S appgroup \
    && adduser -S -G appgroup appuser \
    && chown appuser:appgroup server

USER appuser

EXPOSE 8080

CMD ["./server"]
