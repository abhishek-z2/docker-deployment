FROM node:16-alpine AS build-stage

WORKDIR /app

COPY code/example-frontend/package*.json ./

RUN npm install

COPY code/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080/

RUN npm run build 


FROM node:16-alpine AS production-stage

WORKDIR /app

RUN npm install -g serve \
&& addgroup  -S appgroup \
&& adduser -S -G appgroup appuser

COPY --from=build-stage --chown=appuser:appgroup /app/build ./build

USER appuser

EXPOSE 5001

CMD ["serve", "-s", "-l", "5001", "build"]
